# ============================================
# LLM API 配置（支持 OpenAI / DeepSeek / 其他兼容接口）
# ============================================

# OpenAI 官方
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# DeepSeek (国内可用)
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 硅基流动 SiliconFlow (国内可用)
# OPENAI_API_KEY=sk-your-siliconflow-key
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_MODEL=deepseek-ai/DeepSeek-V3

# 护栏专用 LLM
GUARDRAIL_MODEL=deepseek-v4-flash

# 日志级别
LOG_LEVEL=INFO

# ============================================
# LangSmith 可观测性（SaaS）
# ============================================
LANGSMITH_ENABLED=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
LANGSMITH_PROJECT=travel-agent

# 代理配置
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,.cn,.aliyuncs.com,.deepseek.com